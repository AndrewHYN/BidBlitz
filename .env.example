# BidBlitz environment variables
# Copy to .env.local for local development. NEVER commit real values.

# --- Supabase (required) ---
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...). Safe to expose to the browser.
# Replaces the legacy anon key. Must be paired with RLS on every exposed table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Secret key (sb_secret_...). SERVER ONLY - never prefix with NEXT_PUBLIC_,
# never import into client components, never log. Replaces legacy service_role.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- Database (required for running migrations) ---
# Supabase Dashboard -> Connect -> Session pooler (IPv4-safe) connection string.
# Used only by migration/test tooling, never by the running web app.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0 REGION.pooler.supabase.com:6543/postgres

# --- Application ---
# Public origin used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (settlement sweep) ---
# Shared secret for GET /api/cron/settle. Vercel reads this variable and sends
# it automatically as `Authorization: Bearer <CRON_SECRET>` on every cron tick.
# Generate one: `openssl rand -hex 32`. SERVER ONLY - never prefix with
# NEXT_PUBLIC_. If unset, the route refuses ALL requests (including "Bearer
# undefined"), which is the safe failure: settlement still happens on page views
# and on the bid path, so no auction can end incorrectly without it.
CRON_SECRET=

# --- Optional integrations (leave unset to disable) ---
# PostHog product analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
