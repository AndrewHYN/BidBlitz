# BidBlitz environment variables
# Copy to .env.local for local development. NEVER commit real values.

# --- Supabase (required) ---
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...). Safe to expose to the browser.
# Replaces the legacy anon key. Must be paired with RLS on every exposed table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Secret key (sb_secret_...). SERVER ONLY - never prefix with NEXT_PUBLIC_,
# never import into client components, never log. Replaces legacy service_role.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- Database (required for running migrations) ---
# Supabase Dashboard -> Connect -> Session pooler (IPv4-safe) connection string.
# Used only by migration/test tooling, never by the running web app.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0 REGION.pooler.supabase.com:6543/postgres

# --- Application ---
# Public origin used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (settlement sweep) ---
# Shared secret for GET /api/cron/settle. Vercel reads this variable and sends
# it automatically as `Authorization: Bearer <CRON_SECRET>` on every cron tick.
# Generate one: `openssl rand -hex 32`. SERVER ONLY - never prefix with
# NEXT_PUBLIC_. If unset, the route refuses ALL requests (including "Bearer
# undefined"), which is the safe failure: settlement still happens on page views
# and on the bid path, so no auction can end incorrectly without it.
CRON_SECRET=

# --- Email (Resend) ---
# Transactional mail: Resend API + durable email_outbox dispatcher.
# All three are SERVER ONLY in effect (read via process.env on the server;
# never NEXT_PUBLIC_, never logged, never sent to the browser).
# Without RESEND_API_KEY the dispatcher holds rows QUEUED and reports why;
# nothing pretends mail went out. See docs/EMAIL.md.
# RESEND_API_KEY=re_REPLACE_ME
# EMAIL_FROM=BidBlitz <hello@REPLACE_ME>
# APP_URL=https://bid-blitz-ten.vercel.app
# PostHog product analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Paynow (payment provider) - UNSET BY DEFAULT, AND DELIBERATELY SO ---
# BidBlitz ships with no payment provider configured: every sale is recorded
# as AWAITING_PAYMENT, no money moves, and the UI says exactly that. These
# two values are the ONLY thing that changes that, so leave them commented out
# until a test-mode integration has been created and the full flow has been
# verified end to end (see docs/ARCHITECTURE_DECISIONS.md, ADR-011).
#
# Where the values come from (no secret is ever committed):
#   Paynow dashboard -> Receive Payment Links -> Create Advanced Integration
#   -> Integration Keys -> "Email Key To Company Address" for the key.
#
# Rules:
#   * SERVER ONLY. Never prefix either with NEXT_PUBLIC_, never log the key,
#     never put it in a client bundle. The app reads them from the server and
#     sends only a SHA-512 hash derived from the key to Paynow.
#   * Both or neither. With only one set the provider stays unconfigured and
#     the reason is written to the server log - a half-set integration must
#     never look like a working one.
#   * The callback and return URLs are derived from NEXT_PUBLIC_SITE_URL
#     (set it to https://bid-blitz-ten.vercel.app in production), so there is
#     no third variable to get wrong.
#   * A newly created integration starts in Paynow's TEST mode. Do not request
#     "Set Live" until the sandbox flow has been verified.
# PAYNOW_INTEGRATION_ID=REPLACE_ME
# PAYNOW_INTEGRATION_KEY=REPLACE_ME

# --- Linkwa (alternative provider) - UNSET BY DEFAULT, SAME RULES ---
# Linkwa is the selected marketplace provider (collect + programmatic
# payouts; see docs/ARCHITECTURE_DECISIONS.md, ADR-016). When ALL THREE values
# below are real, BidBlitz boots the Linkwa adapter in preference to Paynow;
# with any of them missing or placeholder the provider stays unconfigured and
# the reason is written to the server log.
#
# Where the values come from (no secret is ever committed):
#   Linkwa dashboard -> Developer Apps -> Developer API key (sk_live_...),
#   the account API origin for LINKWA_BASE_URL, webhook signing secret.
#   For sandbox testing LINKWA_BASE_URL must be the SANDBOX origin from the
#   dashboard, never the production origin: the adapter sends money flows to
#   exactly the origin configured here.
#
# Rules: same as Paynow above. SERVER ONLY, never NEXT_PUBLIC_, never logged.
# All three or nothing. Callback/return URLs still derive from
# NEXT_PUBLIC_SITE_URL, so there is no fourth variable to get wrong.
# Verify the full flow in the free sandbox before subscribing to the USD 5/mo
# Developer plan that unlocks production API access.
#
# SANDBOX SESSIONS (no secrets on disk): do NOT paste sandbox credentials
# here or into .env.local. Instead run scripts/start-linkwa-sandbox.ps1 in
# PowerShell — it prompts for the three values (masked), validates the
# sandbox https origin, sets them as process-only environment variables, and
# launches OpenCode from that same shell so the app inherits them. Closing
# the shell ends the session. Application code already reads these three
# exact names from process.env (src/server/payments/config.ts), so no code
# change is needed for the session to take effect.
# LINKWA_API_KEY=REPLACE_ME
# LINKWA_BASE_URL=REPLACE_ME
# LINKWA_WEBHOOK_SECRET=REPLACE_ME
